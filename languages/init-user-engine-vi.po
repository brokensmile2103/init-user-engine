msgstr "Lần ghi gần nhất: %1$s (%2$s dòng)"

#: includes/write-behind.php:952
msgid "Last write: not yet"
msgstr "Lần ghi gần nhất: chưa có"

#. translators: %s: date and time.
#: includes/write-behind.php:958
msgid "next scheduled: %s"
msgstr "lần kế tiếp: %s"

