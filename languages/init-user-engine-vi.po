msgstr "Dòng bị bỏ qua (chưa từng lưu vào cache): %1$s · Số lần cache bị xoá: %2$s"

#. translators: %s: database error.
#: includes/write-behind.php:986
msgid "Last error: %s"
msgstr "Lỗi gần nhất: %s"

#. translators: %d: minutes.
#: includes/write-behind.php:996
msgid "No buffered rows written for %d minute."
msgid_plural "No buffered rows written for %d minutes."
msgstr[0] "Chưa ghi bộ đệm xuống trong %d phút."

#: includes/write-behind.php:1002
msgid "Rows are written by WP-Cron. If your site runs WP-Cron from a system cron job, they are written at its next run. When the buffer is full, new rows go straight to the database, so nothing is lost while cron is not running."
msgstr "Các dòng được ghi bằng WP-Cron. Nếu site chạy WP-Cron bằng cron của hệ thống (system cron), chúng sẽ được ghi ở lần chạy kế tiếp. Khi bộ đệm đầy, dòng mới được ghi thẳng xuống database nên không mất gì trong lúc cron chưa chạy."

